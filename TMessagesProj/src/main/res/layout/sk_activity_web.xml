<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/rl_container"
        android:layout_width="match_parent"
        android:layout_height="?android:actionBarSize"
        android:background="@android:color/white">

        <androidx.appcompat.widget.AppCompatTextView
            android:id="@+id/title_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="70dip"
            android:layout_marginEnd="70dip"
            android:gravity="center"
            android:maxLines="1"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:textSize="16sp"
            tools:text="WebView" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_action_back"
            android:layout_width="24dip"
            android:layout_height="24dip"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dip"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@drawable/ic_ab_back"
            app:tint="@android:color/black" />

        <androidx.appcompat.widget.AppCompatImageView
            android:visibility="gone"
            android:id="@+id/btn_action_close"
            android:layout_width="24dip"
            android:layout_height="24dip"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="44dip"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@mipmap/sk_icon_close"
            app:tint="@android:color/black" />

        <androidx.appcompat.widget.AppCompatImageView
            android:id="@+id/btn_action_refresh"
            android:layout_width="38dip"
            android:layout_height="38dip"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="10dip"
            android:background="?attr/selectableItemBackgroundBorderless"
            app:srcCompat="@mipmap/editor_rotate"
            app:tint="@android:color/black" />

    </RelativeLayout>

    <FrameLayout
        android:id="@+id/fl_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

</LinearLayout>